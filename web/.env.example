# Public identifiers; these are safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=uttmp3up
NEXT_PUBLIC_SANITY_DATASET=production

# Public origin used for canonical URLs, social metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://blog.formatstack.com

# Optional IndexNow overrides. Vercel sets VERCEL_ENV=production automatically; local and
# preview builds skip submission. The default key file is committed under public/.
# INDEXNOW_KEY_FILE=AFDFAC705D0EB18C08ADF80F69371588.txt
# INDEXNOW_STRICT=false

# Optional, server-only token for private datasets and draft content.
# SANITY_API_READ_TOKEN=

# Server-only secret shared with the Sanity webhook that calls /api/revalidate.
# SANITY_REVALIDATE_SECRET=
